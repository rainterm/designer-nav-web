{
  "name": "designer-nav-web",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Designer网址导航 Electron 应用",
  "author": "designer",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c green,blue \"vite\" \"wait-on http://127.0.0.1:5175 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "preview": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "postinstall": "node scripts/ensure-electron.cjs"
  },
  "dependencies": {
    "naive-ui": "^2.45.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^9.2.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.designer.navweb",
    "productName": "Designer网址导航",
    "executableName": "designer-nav-web",
    "artifactName": "designer-nav-web-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Designer网址导航"
    }
  }
}
